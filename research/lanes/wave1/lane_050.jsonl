{"id": "P00362", "name": "Robert Pender", "name_chinese": "Bob Pender", "country": "United States", "net_worth_usd_m": "13004.2", "net_worth_source": "Forbes real-time", "source_of_wealth": "oil & gas", "industry": "energy", "sec_insider_companies": "Venture Global, Inc. (VG) - See Remarks", "shared_with": "", "appears_on": "Forbes real-time (2026); Forbes real-time (former) (2025); Forbes annual (2025); Hurun Global (2026); Wikidata (2025); SEC insider holdings (2025)", "focus": ["energy"], "forbes_profile_url": "https://www.forbes.com/profile/robert-pender/", "wikidata_url": "http://www.wikidata.org/entity/Q136480350", "forbes_bio": ["Bob Pender cofounded liquified natural gas exporter Venture Global with former investment banker Mike Sabel in 2013.", "Together they own more than 80% of the company, which went public at a nearly $60 billion valuation in January 2025.", "Pender and Sabel serve as Venture Global's executive co-chairmen. They worked together as co-CEOs until 2020 when Pender retired from the role and Sabel became sole chief executive.", "Pender previously practiced law for 28 years and specialized in alternative energy project financings. He worked on more than $35 billion of deals in the sector.", "Pender is married to a niece of President John F. Kennedy."], "forbes_facts": []}
